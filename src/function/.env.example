# Confluence API settings (For content extraction)
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE=

# Azure Settings (Optional)
STORAGE_CONTAINER_NAME=
STORAGE_CONNECTION_STRING=""

# Slack API settings (For Deployment)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Application settings
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000

# Knowledge Base settings
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=100
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
KB_MAX_BATCH_SIZE=10
KB_BATCH_MEMORY_LIMIT=1024
KB_OUTPUT_DIR=data/processed
KB_RAW_DIR=data/raw
KB_DEFAULT_RESULTS=3
